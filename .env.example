# =============================================
# FARMAFLOW - VARIABLES DE ENTORNO
# Copiar este archivo como .env.local para desarrollo
# =============================================

# --- APLICACIÓN ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=tu_secreto_super_seguro_min_32_chars_aqui

# --- BASE DE DATOS (MongoDB Atlas) ---
# Formato: mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/farmaflow?retryWrites=true&w=majority

# --- CLOUDINARY (Almacenamiento de Imágenes) ---
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu_cloud_name

# --- (OPCIONAL) PRIMER ADMIN ---
# Usado por el script de seed para crear el usuario administrador inicial
SEED_ADMIN_EMAIL=supervisor@farmaflow.com
SEED_ADMIN_PASSWORD=cambiar_en_produccion
